{
  "rewrites": [
    { "source": "/r/:code", "destination": "/api/r/:code" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/send-shopping-list?action=check-recalls", "schedule": "0 8 * * *" },
    { "path": "/api/ingest-horrocks?action=ingest-horrocks", "schedule": "0 12 * * *" }
  ]
}
